# ============================================================
# Variables de entorno típicas para landings
# Copiá este archivo a .env.local y completá los valores reales.
# Nada de esto es requerido para que el sitio compile: son hooks
# opcionales de analytics / forms que cada campaña puede usar.
# ============================================================

# Google Analytics 4 (Measurement ID)
NEXT_PUBLIC_GA_ID=

# Form endpoint (ej: Formspree, Basin, propia). Se usa en componentes de formulario.
NEXT_PUBLIC_FORM_ENDPOINT=

# ID de la propiedad en hotjar / otros heatmaps (opcional)
NEXT_PUBLIC_HOTJAR_ID=
